    "ft_fitstrip": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"ft-fitstrip\">\n  <a href=\"/collections/men\"><h3>Men</h3><p>Relaxed unisex cut, Airlume cotton</p></a>\n  <a href=\"/collections/women\"><h3>Women</h3><p>Shaped body, softer hand</p></a>\n  <a href=\"/collections/faith\"><h3>Unisex</h3><p>Relaxed, true to size</p></a>\n</div>",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "ft_fabric": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"ft-editorial ft-editorial-wrap\">\n  <div class=\"ft-editorial-media\"></div>\n  <div class=\"ft-editorial-copy\">\n    <span class=\"ft-eyebrow\">The fabric</span>\n    <h2>Airlume cotton, side-seamed,<br>made to be a favourite by the third wash.</h2>\n    <p>100% combed and ring-spun Airlume cotton, side-seamed so the shape holds\n    instead of twisting. The verse is printed small on the left chest — you'll\n    know it's there, and that's rather the point.</p>\n    <p><a class=\"ft-link\" href=\"/pages/quality\">How we make it &rarr;</a></p>\n  </div>\n</div>",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "ft_churches": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"ft-churches ft-churches-wrap\">\n  <div class=\"ft-churches-copy\">\n    <span class=\"ft-eyebrow\">For churches</span>\n    <h2>Outfit the whole team, or print<br>your own design on our blanks.</h2>\n    <p>Tiered pricing from 24 pieces, one leader pays, and a size-run picker built\n    for a volunteer list rather than a shopping cart.</p>\n    <p class=\"ft-btnrow\">\n      <a class=\"ft-btn ft-btn--dark\" href=\"/pages/for-churches\">Church pricing</a>\n      <a class=\"ft-btn ft-btn--ghost\" href=\"/pages/for-churches#custom\">Custom printing</a>\n    </p>\n  </div>\n  <div class=\"ft-churches-media\"></div>\n</div>",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
