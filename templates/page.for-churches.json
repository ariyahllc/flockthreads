{
  "sections": {
    "main": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "\n<div class=\"ft-page\">\n  <div class=\"ft-page-head\">\n    <h1>Merch your congregation will keep wearing.</h1>\n    <p>Tiered wholesale from 24 pieces, tax-exempt ordering, and a size-run picker\n    built for a volunteer list rather than a shopping cart.</p>\n  </div>\n\n  <div class=\"ft-two\">\n    <div class=\"ft-two-col\">\n      <h3>Wholesale blanks</h3>\n      <ul class=\"ft-dash\">\n        <li>Our house blanks at your tier rate</li>\n        <li>Mixed size runs, no per-size minimum</li>\n        <li>Ships in 3 to 5 business days</li>\n      </ul>\n      <a class=\"ft-link\" href=\"/collections/faith\">Browse the blanks catalog</a>\n    </div>\n    <div class=\"ft-two-col\" id=\"custom\">\n      <h3>Custom printing</h3>\n      <ul class=\"ft-dash\">\n        <li>Your logo or artwork on our blanks</li>\n        <li>Free artwork clean-up on first order</li>\n        <li>Digital proof in two days, delivery in 10 to 14</li>\n      </ul>\n      <a class=\"ft-link\" href=\"#ft-account\">Start a custom order</a>\n    </div>\n  </div>\n\n  <div class=\"ft-tier\">\n    <div class=\"ft-tier-table\">\n      <span class=\"ft-eyebrow\">Tier pricing</span>\n      <h2 class=\"ft-h2 ft-h2--flush\">The more you order, the lower it goes</h2>\n      <div class=\"ft-tablewrap\">\n        <table class=\"ft-table\">\n          <thead><tr><th>Quantity</th><th>Per tee</th><th>Custom print add-on</th></tr></thead>\n          <tbody>\n            <tr><td>1 &ndash; 23</td><td>$26.99</td><td>Retail</td></tr>\n            <tr><td>24 &ndash; 99</td><td>$21</td><td>+$4</td></tr>\n            <tr><td>100 &ndash; 249</td><td>$19</td><td>+$3</td></tr>\n            <tr><td>250 +</td><td>$17</td><td>+$2</td></tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"ft-tablenote\">Retail is $26.99 per tee. Tiers apply automatically once your\n      church account is approved &mdash; no codes to remember. Final rate is confirmed on approval.</p>\n    </div>\n\n    <aside class=\"ft-estimate\">\n      <span class=\"ft-eyebrow ft-eyebrow--light\">Estimate your order</span>\n      <label class=\"ft-fit-label ft-fit-label--light\" style=\"margin-top:1.4rem\">Quantity <output id=\"ftQty\" style=\"float:right\">48</output></label>\n      <input type=\"range\" id=\"ftQ\" min=\"24\" max=\"400\" step=\"1\" value=\"48\">\n      <label class=\"ft-check\"><input type=\"checkbox\" id=\"ftPrint\" checked> Add custom printing, one placement</label>\n      <dl class=\"ft-fit-meta\" style=\"margin-top:1.4rem\">\n        <div><dt>Your tier</dt><dd id=\"ftTier\">24 &ndash; 99</dd></div>\n        <div><dt>Per piece</dt><dd id=\"ftPer\">$25</dd></div>\n      </dl>\n      <span class=\"ft-eyebrow ft-eyebrow--light\">Estimated total</span>\n      <div class=\"ft-estimate-total\" id=\"ftTotal\">$1,200</div>\n      <p class=\"ft-estimate-note\" id=\"ftSave\">About $96 below retail on 48 pieces.</p>\n      <a class=\"ft-btn ft-btn--light\" href=\"#ft-account\">Request this quote</a>\n    </aside>\n  </div>\n\n  <h2 class=\"ft-h2\">How a church order runs</h2>\n  <div class=\"ft-steps\">\n    <div class=\"ft-step\"><span>01</span><h3>Request an account</h3><p>One form with your EIN. Approved within a business day.</p></div>\n    <div class=\"ft-step\"><span>02</span><h3>Pick blanks or send art</h3><p>Browse wholesale blanks, or upload a design for us to print.</p></div>\n    <div class=\"ft-step\"><span>03</span><h3>Approve the proof</h3><p>Digital proof in two days. Nothing prints until you say so.</p></div>\n    <div class=\"ft-step\"><span>04</span><h3>Reorder in two clicks</h3><p>Your size run is saved. Repeat it any time from the dashboard.</p></div>\n  </div>\n\n  <div class=\"ft-account\" id=\"ft-account\">\n    <div class=\"ft-account-copy\">\n      <h2 class=\"ft-h2 ft-h2--flush\">Request a church account</h2>\n      <p>One form, once. We verify your organisation, switch on tier pricing and\n      tax-exempt checkout, and you order like anyone else &mdash; just at your rate.</p>\n      <ul class=\"ft-dash\">\n        <li>Approved in one business day</li>\n        <li>Net 30 available after your first order</li>\n        <li>Multiple staff on one account</li>\n      </ul>\n    </div>\n    <div class=\"ft-account-form\">\n      {% form 'contact' %}\n        {% if form.posted_successfully? %}\n          <p class=\"ft-note\">Thank you \u2014 we&rsquo;ve got it. Expect a reply within one business day.</p>\n        {% endif %}\n        <div class=\"ft-field-grid\">\n          <input type=\"text\"  name=\"contact[organisation]\" placeholder=\"Church or organisation\" required>\n          <input type=\"text\"  name=\"contact[name]\"         placeholder=\"Your name\" required>\n          <input type=\"email\" name=\"contact[email]\"        placeholder=\"Work email\" required>\n          <input type=\"tel\"   name=\"contact[phone]\"        placeholder=\"Phone\">\n          <input type=\"text\"  name=\"contact[congregation_size]\" placeholder=\"Congregation size\">\n          <input type=\"text\"  name=\"contact[ein]\"          placeholder=\"EIN (for tax exemption)\">\n        </div>\n        <span class=\"ft-fit-label\" style=\"margin-top:1.2rem\">What do you need?</span>\n        <div class=\"ft-seg ft-seg--form\">\n          <label><input type=\"radio\" name=\"contact[need]\" value=\"Blanks\" checked> Blanks</label>\n          <label><input type=\"radio\" name=\"contact[need]\" value=\"Printing\"> Printing</label>\n          <label><input type=\"radio\" name=\"contact[need]\" value=\"Both\"> Both</label>\n        </div>\n        <textarea name=\"contact[body]\" rows=\"4\" placeholder=\"Anything else? Dates, size runs, budget.\"></textarea>\n        <button type=\"submit\" class=\"ft-btn ft-btn--dark ft-btn--block\">Request account</button>\n      {% endform %}\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var Q=document.getElementById('ftQ'); if(!Q) return;\n  var RETAIL=26.99;\n  var TIERS=[{min:250,per:17,add:2,label:'250 +'},\n             {min:100,per:19,add:3,label:'100 \u2013 249'},\n             {min:24, per:21,add:4,label:'24 \u2013 99'}];\n  var qty=document.getElementById('ftQty'),tier=document.getElementById('ftTier'),\n      per=document.getElementById('ftPer'),tot=document.getElementById('ftTotal'),\n      save=document.getElementById('ftSave'),print=document.getElementById('ftPrint');\n  var money=function(n){return '$'+n.toLocaleString('en-US',{maximumFractionDigits:0});};\n  function calc(){\n    var n=+Q.value;\n    var t=TIERS.find(function(x){return n>=x.min;}) || TIERS[TIERS.length-1];\n    var unit=t.per + (print.checked ? t.add : 0);\n    var total=unit*n, saved=(RETAIL*n)-total;\n    qty.textContent=n; tier.innerHTML=t.label; per.textContent=money(unit);\n    tot.textContent=money(total);\n    save.textContent='About '+money(saved)+' below retail on '+n+' pieces.';\n  }\n  Q.addEventListener('input',calc); print.addEventListener('change',calc); calc();\n})();\n</script>\n",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
  "order": [
    "main"
  ]
}