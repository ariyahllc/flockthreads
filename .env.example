# Copy to .env and fill. NEVER commit .env (gitignored).

# Shopify Admin API (from a custom app in Shopify admin:
#   Settings > Apps and sales channels > Develop apps > Create app > Admin API scopes:
#   write_products, write_content, write_publications, read_orders, write_orders)
SHOPIFY_STORE=flockthreads.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07

# Print provider (pick ONE as primary = wash-test winner). Lock the provider — no auto-cheapest.
PRINTFUL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# GELATO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Which provider is live: printful | gelato
POD_PROVIDER=printful
