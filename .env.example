# Copy to .env and fill. NEVER commit .env (gitignored).

# Shopify — use the *.myshopify.com admin domain, NOT your custom domain.
SHOPIFY_STORE=krw50b-fh.myshopify.com
SHOPIFY_API_VERSION=2025-07

# NEW custom app (created 2026+): app has Client ID + Client secret.
# Script mints a 24h token itself via OAuth client_credentials — no manual token.
# Find in: Settings > Apps and sales channels > Develop apps > your app >
#          API credentials > Client credentials.
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# LEGACY custom app (pre-2026) alternative: a permanent shpat_ token instead of the above.
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Print provider (pick ONE as primary = wash-test winner). Lock the provider — no auto-cheapest.
PRINTFUL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# GELATO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Which provider is live: printful | gelato
POD_PROVIDER=printful
